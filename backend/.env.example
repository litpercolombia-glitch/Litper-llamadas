# Zynex Connect / Litper Connect Hub - variables del backend (FastAPI).
# SOLO NOMBRES. Nunca pongas valores reales aqui ni hagas commit de un .env.
# Local: copia a backend/.env. En Render: se pegan en el dashboard (sync:false).

# --- Obligatorias ---
MONGO_URL=            # mongodb+srv://... de Atlas M0
DB_NAME=              # p.ej. zynex_staging
JWT_SECRET=           # firma de la cookie de sesion
ENCRYPTION_KEY=       # llave Fernet (credenciales por cliente)
CORS_ORIGINS=         # URL(s) del frontend separadas por coma
APP_PUBLIC_URL=       # URL publica del frontend

# --- Acceso API / multi-tenant ---
PUBLIC_API_KEY=
PLATFORM_KEYS_ORGS=

# --- IA / LLM ---
OPENROUTER_API_KEY=
OPENROUTER_MODEL_DEFAULT=
OPENROUTER_MODEL_REASONING=
ANTHROPIC_MODEL=
GEMINI_MODEL=
LLM_API_KEY=
TRANSLATION_PROVIDER=

# --- Voz: ElevenLabs / Retell ---
ELEVENLABS_API_KEY=
ELEVEN_API_KEY=
ELEVENLABS_AGENT_ID=
ELEVENLABS_BASE_URL=
ELEVENLABS_DEFAULT_VOICE_ID=
ELEVENLABS_SIP_CALL_PATH=
ELEVENLABS_SIP_REGISTER_PATH=
RETELL_API_KEY=

# --- Telefonia: Twilio / Telnyx / DIDWW ---
CALLER_ID_NUMBER=
SIP_PROVIDER=
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_STATUS_CALLBACK_BASE=
TELNYX_API_KEY=
TELNYX_CONNECTION_ID=
TELNYX_PHONE_NUMBER=
TELNYX_SIP_DOMAIN=
TELNYX_SIP_USERNAME=
TELNYX_SIP_PASSWORD=
DIDWW_OUTBOUND_TRUNK_ID=
DIDWW_SIP_DOMAIN=
DIDWW_SIP_USERNAME=
DIDWW_SIP_PASSWORD=

# --- WhatsApp: Chatea Pro ---
CHATEA_PRO_API_KEY=
CHATEA_PRO_BASE_URL=
CHATEA_PRO_ME_PATH=
CHATEA_PRO_SEND_TEMPLATE_PATH=
CHATEA_PRO_SEND_TEXT_PATH=
CHATEA_PRO_SUBSCRIBER_CREATE_PATH=
CHATEA_PRO_SUBSCRIBER_GET_PATH=
CHATEA_PRO_TEMPLATE_LIST_PATH=
CEO_REPORT_WA_TARGET=
VIP_GROUP_URL=

# --- Supabase (sync opcional) ---
SUPABASE_URL=
SUPABASE_ANON_KEY=
SUPABASE_SERVICE_KEY=

# --- Email (SMTP) ---
SMTP_HOST=
SMTP_PORT=
SMTP_USER=
SMTP_PASSWORD=
SMTP_FROM=
SMTP_STARTTLS=
FEEDBACK_EMAIL=

# --- Scheduler ---
SCHEDULER_TICK_MINUTES=

# Frontend (frontend/.env.production, ya versionado): REACT_APP_BACKEND_URL vacia
# = el build llama a /api en su mismo dominio y Render lo reenvia al backend.
